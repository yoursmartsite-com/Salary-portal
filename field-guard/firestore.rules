rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }
    function activeAdminRole() {
      return signedIn()
        && exists(adminDoc())
        && get(adminDoc()).data.active == true
        && get(adminDoc()).data.role in ['owner', 'admin'];
    }
    function isOwner() {
      return signedIn()
        && exists(adminDoc())
        && get(adminDoc()).data.active == true
        && get(adminDoc()).data.role == 'owner';
    }
    function isManager() {
      return signedIn()
        && exists(adminDoc())
        && get(adminDoc()).data.active == true
        && get(adminDoc()).data.role == 'manager';
    }
    function isSupervisor() { return activeAdminRole() || isManager(); }
    function managerOwns(data) {
      return isManager() && data.managerUid == request.auth.uid;
    }
    function employeeDoc() {
      return /databases/$(database)/documents/employees/$(request.auth.uid);
    }
    function isActiveEmployee() {
      return signedIn()
        && exists(employeeDoc())
        && get(employeeDoc()).data.active != false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list, create, update, delete: if isOwner();
    }

    match /employees/{uid} {
      allow get: if activeAdminRole()
        || (signedIn() && request.auth.uid == uid && isActiveEmployee())
        || managerOwns(resource.data);
      allow list: if activeAdminRole() || managerOwns(resource.data);
      allow create: if activeAdminRole()
        || (isManager() && request.resource.data.managerUid == request.auth.uid
          && request.resource.data.teamId == request.auth.uid);
      allow update: if activeAdminRole()
        || (managerOwns(resource.data)
          && request.resource.data.managerUid == request.auth.uid
          && request.resource.data.teamId == request.auth.uid);
      allow delete: if activeAdminRole() || managerOwns(resource.data);
    }

    match /attendance/{recordId} {
      allow read: if activeAdminRole()
        || managerOwns(resource.data)
        || (isActiveEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update: if activeAdminRole()
        || (isManager() && request.resource.data.managerUid == request.auth.uid);
      allow delete: if activeAdminRole() || managerOwns(resource.data);
    }

    match /inspection_rounds/{roundId} {
      allow read: if activeAdminRole() || managerOwns(resource.data);
      allow create, update: if activeAdminRole()
        || (isManager() && request.resource.data.managerUid == request.auth.uid);
      allow delete: if activeAdminRole() || managerOwns(resource.data);
    }

    match /work_areas/{areaId} {
      allow read: if activeAdminRole() || managerOwns(resource.data);
      allow create, update: if activeAdminRole()
        || (isManager() && request.resource.data.managerUid == request.auth.uid);
      allow delete: if activeAdminRole() || managerOwns(resource.data);
    }

    match /settings/{settingId} {
      allow read: if activeAdminRole()
        || (isManager() && settingId == 'manager_' + request.auth.uid);
      allow create, update: if isOwner()
        || (isManager() && settingId == 'manager_' + request.auth.uid
          && request.resource.data.managerUid == request.auth.uid);
      allow delete: if isOwner() || managerOwns(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}