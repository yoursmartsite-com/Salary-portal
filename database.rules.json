          }
        },
        "playersCount": {
          ".write": "auth != null && newData.isNumber() && ((root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && newData.val() >= 1 && newData.val() <= 2) || (root.child('rooms').child($roomId).child('game').val() === 'chess' && data.val() === 1 && newData.val() === 2 && newData.parent().child('blackUid').val() === auth.uid))"
        },
        "state": {
          ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 180"
          }
        },
        "blackUid": {
          ".write": "auth != null && auth.uid === newData.val() && data.val() === '' && root.child('rooms').child($roomId).child('game').val() === 'chess'"
        },
        "updatedAt": {
          ".write": "auth != null && newData.isNumber() && (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() || (root.child('rooms').child($roomId).child('game').val() === 'chess' && newData.parent().child('blackUid').val() === auth.uid))"
        },
        "map": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid"
        }
      }
    },
