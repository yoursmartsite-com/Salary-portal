        ".read": "auth != null && (auth.uid === $uid || (auth.uid === '91N0rI5SCDN1aKBXJkowj5KcUOz1' || auth.token.email === 'fibrahem865@gmail.com'))",
        ".write": "auth != null && (auth.uid === '91N0rI5SCDN1aKBXJkowj5KcUOz1' || auth.token.email === 'fibrahem865@gmail.com')"
      }
    },
