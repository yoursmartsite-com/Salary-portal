        "$fromUid": {
          ".read": "auth != null && (auth.uid === $toUid || auth.uid === $fromUid || (auth.uid === '91N0rI5SCDN1aKBXJkowj5KcUOz1' || auth.token.email === 'fibrahem865@gmail.com'))",
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid || (auth.uid === '91N0rI5SCDN1aKBXJkowj5KcUOz1' || auth.token.email === 'fibrahem865@gmail.com'))"
        }
      }
