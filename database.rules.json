{
  "rules": {
    "onlineRooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "game": {
          ".write": "auth != null && root.child('onlineRooms').child($roomId).child('host').val() === auth.uid"
        },
        "gameUpdatedBy": {
          ".write": "auth != null && root.child('onlineRooms').child($roomId).child('host').val() === auth.uid"
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid','name','text','at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 300"
          }
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "updatedAt"
      ],
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && !data.exists() && newData.child('hostUid').val() === auth.uid",
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && (auth.uid === $uid || root.child('rooms').child($roomId).child('hostUid').val() === auth.uid)"
          }
        },
        "playersCount": {
          ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "state": {
          ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && root.child('adminModeration').child(auth.uid).child('banned').val() != true && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 180"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$toUid": {
        ".read": "auth != null && (auth.uid === $toUid || data.child('fromUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $toUid || newData.child('fromUid').val() === auth.uid)"
      }
    },
    "adminGifts": {
      ".read": "auth != null && auth.token.email === 'fibrahem865@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'"
      }
    },
    "siteAnnouncements": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'",
      ".indexOn": [
        "at"
      ]
    },
    "adminModeration": {
      ".read": "auth != null && auth.token.email === 'fibrahem865@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('friendRequests').child(auth.uid).child($uid).child('status').val() === 'pending' || root.child('friends').child(auth.uid).child($uid).exists())"
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && (auth.uid === $toUid || auth.token.email === 'fibrahem865@gmail.com')",
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $toUid || auth.uid === $fromUid || auth.token.email === 'fibrahem865@gmail.com')",
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid || auth.token.email === 'fibrahem865@gmail.com')"
        }
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'",
        ".validate": "newData.hasChildren(['balance'])",
        "balance": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991"
        }
      }
    },
    "coinTransfers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'"
      }
    },
    "purchaseRequests": {
      ".read": "auth != null && auth.token.email === 'fibrahem865@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        "$requestId": {
          ".write": "auth != null && (auth.token.email === 'fibrahem865@gmail.com' || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'))"
        }
      }
    },
    "inventory": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'fibrahem865@gmail.com')",
        ".write": "auth != null && auth.token.email === 'fibrahem865@gmail.com'"
      }
    },
    "globalChat": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$messageId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 300",
        ".validate": "newData.hasChildren(['uid','name','text','at']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 32 && newData.child('text').isString() && newData.child('text').val().length <= 300 && newData.child('at').isNumber()"
      }
    }
  }
}
