{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "cart": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL_HERE')",
        "$orderId": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('status').val() === 'new') || auth.token.email === 'ADMIN_EMAIL_HERE')",
          ".validate": "auth.token.email === 'ADMIN_EMAIL_HERE' || (newData.hasChildren(['id','name','phone','address','items','total','status','paymentMethod','createdAt']) && newData.child('status').val() === 'new' && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('items').hasChildren())"
        }
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'"
    }
  }
}
