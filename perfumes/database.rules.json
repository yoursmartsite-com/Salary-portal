{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "cart": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
      ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL_HERE')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'ADMIN_EMAIL_HERE')"
      }
    }
  }
}